<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_invoice_view_search" model="ir.ui.view">
        <field name="name">nme.invoice.view.search</field>
        <field name="model">nme.invoice</field>
        <field name="arch" type="xml">
            <search string="Invoices">
                <field
                    name="name"
                    string="Invoice"
                    filter_domain="['|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('partner_id', 'child_of', self)]"
                />
                <field name="partner_id" operator="child_of" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_posted"
                    string="Posted"
                    domain="[('state', '=', 'posted')]"
                />
                <separator />
                <filter
                    name="filter_unpaid"
                    string="Not Paid"
                    domain="[('state', '=', 'posted'), ('payment_state', '!=', 'paid')]"
                />
                <filter
                    name="filter_overdue"
                    string="Overdue"
                    domain="[('is_overdue', '=', True)]"
                />
                <separator />
                <filter
                    name="filter_invoice_date"
                    string="Invoice Date"
                    date="invoice_date"
                />
                <filter
                    name="filter_due_date"
                    string="Due Date"
                    date="invoice_date_due"
                />
                <group>
                    <filter
                        name="group_by_partner"
                        string="Partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_by_payment_state"
                        string="Payment Status"
                        context="{'group_by': 'payment_state'}"
                    />
                    <filter
                        name="group_by_invoice_date"
                        string="Invoice Date"
                        context="{'group_by': 'invoice_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="nme_invoice_view_list" model="ir.ui.view">
        <field name="name">nme.invoice.view.list</field>
        <field name="model">nme.invoice</field>
        <field name="arch" type="xml">
            <list
                string="Invoices"
                sample="1"
                decoration-muted="state == 'cancel'"
                decoration-info="state == 'draft'"
            >
                <field name="currency_id" column_invisible="True" />
                <field name="move_type" column_invisible="True" />
                <field name="name" decoration-bf="1" />
                <field name="partner_id" />
                <field name="invoice_date" />
                <field
                    name="invoice_date_due"
                    decoration-danger="is_overdue"
                    optional="show"
                />
                <field name="is_overdue" column_invisible="True" />
                <field name="ref" optional="hide" />
                <field
                    name="amount_untaxed"
                    sum="Total Untaxed"
                    widget="monetary"
                    optional="hide"
                />
                <field name="amount_total" sum="Total" widget="monetary" />
                <field
                    name="amount_residual"
                    sum="Amount Due"
                    widget="monetary"
                    optional="show"
                />
                <field
                    name="payment_state"
                    widget="badge"
                    decoration-success="payment_state == 'paid'"
                    decoration-warning="payment_state == 'partial'"
                    decoration-danger="payment_state == 'not_paid' and is_overdue"
                    invisible="state != 'posted'"
                    optional="show"
                />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'posted'"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="nme_invoice_view_form" model="ir.ui.view">
        <field name="name">nme.invoice.view.form</field>
        <field name="model">nme.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <header>
                    <button
                        name="action_post"
                        type="object"
                        string="Post"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        data-hotkey="v"
                    />
                    <button
                        name="action_register_payment"
                        type="object"
                        string="Register Payment"
                        class="btn-primary"
                        invisible="state != 'posted' or payment_state == 'paid'"
                        data-hotkey="g"
                    />
                    <button
                        name="action_invoice_send"
                        type="object"
                        string="Send by Email"
                        invisible="state != 'posted' or move_type != 'out_invoice'"
                    />
                    <button
                        name="nme_invoicing.action_report_nme_invoice"
                        type="action"
                        string="Print"
                        invisible="state == 'cancel'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state == 'draft'"
                        groups="nme_invoicing.nme_group_invoicing_manager"
                    />
                    <button
                        name="action_open_cancel_wizard"
                        type="object"
                        string="Cancel"
                        invisible="state == 'cancel'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,posted"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_payments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="not payment_count"
                        >
                            <field
                                name="payment_count"
                                widget="statinfo"
                                string="Payments"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Paid"
                        bg_color="text-bg-success"
                        invisible="payment_state != 'paid'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Partial"
                        bg_color="text-bg-warning"
                        invisible="payment_state != 'partial'"
                    />
                    <div class="oe_title">
                        <span class="o_form_label">
                            <field name="move_type" readonly="1" />
                        </span>
                        <h1>
                            <field name="display_name" invisible="state != 'draft'" />
                            <field name="name" invisible="state == 'draft'" />
                        </h1>
                    </div>
                    <group>
                        <group name="partner">
                            <field name="partner_id" readonly="state != 'draft'" />
                            <field name="ref" readonly="state != 'draft'" />
                            <field name="sale_order_id" invisible="not sale_order_id" />
                            <field
                                name="purchase_order_id"
                                invisible="not purchase_order_id"
                            />
                        </group>
                        <group name="dates">
                            <field name="invoice_date" readonly="state != 'draft'" />
                            <field
                                name="payment_term_id"
                                readonly="state != 'draft'"
                                options="{'no_create': True}"
                            />
                            <field
                                name="invoice_date_due"
                                readonly="state != 'draft'"
                                decoration-danger="is_overdue"
                            />
                            <field name="is_overdue" invisible="1" />
                            <field name="payment_state" invisible="state != 'posted'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="product_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="name" optional="show" />
                                    <field name="quantity" />
                                    <field name="uom_id" optional="show" />
                                    <field name="price_unit" />
                                    <field name="discount" optional="show" />
                                    <field
                                        name="tax_ids"
                                        widget="many2many_tags"
                                        options="{'no_create': True}"
                                        domain="[('company_id', '=', parent.company_id)]"
                                    />
                                    <field name="currency_id" column_invisible="True" />
                                    <field name="price_subtotal" widget="monetary" />
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" name="totals">
                                <field name="currency_id" invisible="1" />
                                <field name="amount_untaxed" widget="monetary" />
                                <field name="amount_tax" widget="monetary" />
                                <field
                                    name="amount_total"
                                    widget="monetary"
                                    class="oe_subtotal_footer_separator"
                                />
                                <field
                                    name="amount_paid"
                                    widget="monetary"
                                    invisible="not amount_paid"
                                />
                                <field
                                    name="amount_residual"
                                    widget="monetary"
                                    class="oe_subtotal_footer_separator"
                                    invisible="state != 'posted'"
                                />
                            </group>
                            <field name="note" placeholder="Payment instructions..." />
                        </page>
                        <page string="Other Information" name="other_info">
                            <group>
                                <group name="responsible">
                                    <field name="user_id" />
                                    <field
                                        name="company_id"
                                        groups="base.group_multi_company"
                                        readonly="state != 'draft'"
                                    />
                                </group>
                                <group
                                    name="cancellation"
                                    invisible="not cancel_reason"
                                >
                                    <field name="cancel_reason" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="nme_invoice_action_customer" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">nme.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a customer invoice</p>
            <p>Invoices are usually created from delivered sales orders.</p>
        </field>
    </record>

    <record id="nme_invoice_action_vendor" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">nme.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a vendor bill</p>
            <p>Bills are usually created from received purchase orders.</p>
        </field>
    </record>

    <record id="nme_invoice_action_post" model="ir.actions.server">
        <field name="name">Post Invoices</field>
        <field name="model_id" ref="model_nme_invoice" />
        <field name="binding_model_id" ref="model_nme_invoice" />
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('nme_group_invoicing_user'))]" />
        <field name="state">code</field>
        <field
            name="code"
        >records.filtered(lambda inv: inv.state == 'draft').action_post()</field>
    </record>
</odoo>
