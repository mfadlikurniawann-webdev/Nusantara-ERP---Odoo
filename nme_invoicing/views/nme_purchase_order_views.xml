<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_purchase_order_view_form" model="ir.ui.view">
        <field name="name">nme.purchase.order.view.form.inherit.nme.invoicing</field>
        <field name="model">nme.purchase.order</field>
        <field name="inherit_id" ref="nme_purchase.nme_purchase_order_view_form" />
        <field name="arch" type="xml">
            <button name="action_rfq_send" position="before">
                <button
                    name="action_create_bill"
                    type="object"
                    string="Create Bill"
                    class="btn-primary"
                    invisible="invoice_status != 'to_invoice'"
                    groups="nme_invoicing.nme_group_invoicing_user"
                />
            </button>
            <div name="button_box" position="inside">
                <button
                    name="action_view_bills"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="not invoice_count"
                >
                    <field name="invoice_count" widget="statinfo" string="Bills" />
                </button>
            </div>
            <field name="receipt_status" position="after">
                <field name="invoice_status" invisible="state != 'purchase'" />
            </field>
            <field name="qty_received" position="after">
                <field
                    name="qty_invoiced"
                    optional="show"
                    column_invisible="parent.state != 'purchase'"
                />
            </field>
        </field>
    </record>

    <record id="nme_purchase_order_view_list" model="ir.ui.view">
        <field name="name">nme.purchase.order.view.list.inherit.nme.invoicing</field>
        <field name="model">nme.purchase.order</field>
        <field name="inherit_id" ref="nme_purchase.nme_purchase_order_view_list" />
        <field name="arch" type="xml">
            <field name="receipt_status" position="after">
                <field
                    name="invoice_status"
                    widget="badge"
                    optional="show"
                    decoration-success="invoice_status == 'invoiced'"
                    decoration-info="invoice_status == 'to_invoice'"
                    invisible="state != 'purchase'"
                />
            </field>
        </field>
    </record>

    <record id="nme_purchase_order_action_to_bill" model="ir.actions.act_window">
        <field name="name">Orders to Bill</field>
        <field name="res_model">nme.purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('invoice_status', '=', 'to_invoice')]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
