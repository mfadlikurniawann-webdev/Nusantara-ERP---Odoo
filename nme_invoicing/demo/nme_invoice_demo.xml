<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Invoice of the delivered sales order, partially paid -->
    <function
        model="nme.sale.order"
        name="action_create_invoice"
        eval="[[ref('nme_sales.nme_sale_order_demo_delivered')]]"
    />
    <function
        model="nme.invoice"
        name="action_post"
        eval="[obj().env.ref('nme_sales.nme_sale_order_demo_delivered').invoice_ids.ids]"
    />
    <record id="nme_payment_demo_partial" model="nme.payment">
        <field
            name="invoice_id"
            model="nme.invoice"
            eval="obj().env.ref('nme_sales.nme_sale_order_demo_delivered').invoice_ids.id"
        />
        <field name="amount">2000000</field>
        <field name="method">bank</field>
        <field name="memo">Transfer BCA</field>
    </record>

    <!-- Manual invoice issued 45 days ago with 30 days terms: overdue -->
    <record id="nme_invoice_demo_overdue" model="nme.invoice">
        <field name="move_type">out_invoice</field>
        <field name="partner_id" ref="nme_base.nme_partner_minimarket_berkah" />
        <field
            name="invoice_date"
            eval="(DateTime.today() - timedelta(days=45)).strftime('%Y-%m-%d')"
        />
        <field name="payment_term_id" ref="nme_base.nme_payment_term_30_days" />
        <field
            name="line_ids"
            eval="[(0, 0, {'product_id': ref('nme_base.nme_product_noodles_box'), 'quantity': 12})]"
        />
    </record>
    <function
        model="nme.invoice"
        name="action_post"
        eval="[[ref('nme_invoice_demo_overdue')]]"
    />

    <!-- Bill of the received purchase order, paid -->
    <function
        model="nme.purchase.order"
        name="action_create_bill"
        eval="[[ref('nme_purchase.nme_purchase_order_demo_received')]]"
    />
    <function
        model="nme.invoice"
        name="action_post"
        eval="[obj().env.ref('nme_purchase.nme_purchase_order_demo_received').invoice_ids.ids]"
    />
    <record id="nme_payment_demo_bill" model="nme.payment">
        <field
            name="invoice_id"
            model="nme.invoice"
            eval="obj().env.ref('nme_purchase.nme_purchase_order_demo_received').invoice_ids.id"
        />
        <field
            name="amount"
            model="nme.invoice"
            eval="obj().env.ref('nme_purchase.nme_purchase_order_demo_received').invoice_ids.amount_total"
        />
        <field name="method">bank</field>
        <field name="memo">Payment BN-0915</field>
    </record>
</odoo>
