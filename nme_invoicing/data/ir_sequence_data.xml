<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- No gap: numbers are only taken when an invoice is posted. -->
    <record id="seq_nme_invoice_out" model="ir.sequence">
        <field name="name">Customer Invoices</field>
        <field name="code">nme.invoice.out</field>
        <field name="prefix">INV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="seq_nme_invoice_in" model="ir.sequence">
        <field name="name">Vendor Bills</field>
        <field name="code">nme.invoice.in</field>
        <field name="prefix">BILL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="seq_nme_payment" model="ir.sequence">
        <field name="name">Payments</field>
        <field name="code">nme.payment</field>
        <field name="prefix">PAY/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>
