<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="mail_template_nme_invoice" model="mail.template">
        <field name="name">Nusantara ERP: Send Invoice</field>
        <field name="model_id" ref="model_nme_invoice" />
        <field
            name="subject"
        >{{ object.company_id.name }} Invoice (Ref {{ object.name }})</field>
        <field
            name="email_from"
        >{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to" eval="False" />
        <field name="use_default_to" eval="True" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field
            name="report_template_ids"
            eval="[(4, ref('action_report_nme_invoice'))]"
        />
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello <t t-out="object.partner_id.name or ''">Toko Makmur Jaya</t>,
                    <br /><br />
                    Please find attached the invoice
                    <strong t-out="object.name or ''">INV/2026/00001</strong>
                    amounting to
                    <strong
                        t-out="format_amount(object.amount_total, object.currency_id) or ''"
                    >Rp 1.000.000</strong>,
                    due on
                    <t
                        t-out="format_date(object.invoice_date_due) or ''"
                    >01/31/2026</t>.
                    <t t-if="object.payment_state == 'partial'">
                        <br />Amount still due:
                        <strong
                            t-out="format_amount(object.amount_residual, object.currency_id) or ''"
                        >Rp 500.000</strong>.
                    </t>
                    <br /><br />
                    Thank you for your business.
                </p>
            </div>
        </field>
    </record>
</odoo>
