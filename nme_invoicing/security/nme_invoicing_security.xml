<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_privilege_invoicing" model="res.groups.privilege">
        <field name="name">Invoicing</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_nusantara_erp" />
    </record>

    <record id="nme_group_invoicing_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="nme_privilege_invoicing" />
        <field
            name="implied_ids"
            eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"
        />
        <field
            name="comment"
        >Creates and posts invoices and vendor bills, registers payments.</field>
    </record>

    <record id="nme_group_invoicing_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="nme_privilege_invoicing" />
        <field
            name="implied_ids"
            eval="[(4, ref('nme_group_invoicing_user')), (4, ref('nme_base.nme_group_master_data_manager'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field
            name="comment"
        >Also cancels or resets posted invoices and cancels payments.</field>
    </record>
</odoo>
