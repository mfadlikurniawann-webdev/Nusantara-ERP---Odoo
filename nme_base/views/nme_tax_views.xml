<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_tax_view_search" model="ir.ui.view">
        <field name="name">nme.tax.view.search</field>
        <field name="model">nme.tax</field>
        <field name="arch" type="xml">
            <search string="Taxes">
                <field name="name" />
                <filter
                    name="filter_sale"
                    string="Sales"
                    domain="[('type_tax_use', '=', 'sale')]"
                />
                <filter
                    name="filter_purchase"
                    string="Purchases"
                    domain="[('type_tax_use', '=', 'purchase')]"
                />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="nme_tax_view_list" model="ir.ui.view">
        <field name="name">nme.tax.view.list</field>
        <field name="model">nme.tax</field>
        <field name="arch" type="xml">
            <list string="Taxes" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="type_tax_use" />
                <field name="amount" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="nme_tax_action" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">nme.tax</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
