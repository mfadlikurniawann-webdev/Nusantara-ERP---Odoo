<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_warehouse_view_list" model="ir.ui.view">
        <field name="name">nme.warehouse.view.list</field>
        <field name="model">nme.warehouse</field>
        <field name="arch" type="xml">
            <list string="Warehouses">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="lot_stock_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="nme_warehouse_view_form" model="ir.ui.view">
        <field name="name">nme.warehouse.view.form</field>
        <field name="model">nme.warehouse</field>
        <field name="arch" type="xml">
            <form string="Warehouse">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Surabaya Main Warehouse"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. SBY" />
                            <field name="partner_id" />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="lot_stock_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Locations" name="locations">
                            <field name="location_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="usage" readonly="1" />
                                    <field name="complete_name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nme_warehouse_action" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">nme.warehouse</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
