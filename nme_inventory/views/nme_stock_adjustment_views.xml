<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_stock_adjustment_view_search" model="ir.ui.view">
        <field name="name">nme.stock.adjustment.view.search</field>
        <field name="model">nme.stock.adjustment</field>
        <field name="arch" type="xml">
            <search string="Stock Adjustments">
                <field name="name" />
                <field name="warehouse_id" />
                <field name="reason_id" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_done"
                    string="Done"
                    domain="[('state', '=', 'done')]"
                />
                <group>
                    <filter
                        name="group_by_reason"
                        string="Reason"
                        context="{'group_by': 'reason_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="nme_stock_adjustment_view_list" model="ir.ui.view">
        <field name="name">nme.stock.adjustment.view.list</field>
        <field name="model">nme.stock.adjustment</field>
        <field name="arch" type="xml">
            <list string="Stock Adjustments" decoration-muted="state == 'cancel'">
                <field name="name" />
                <field name="date" />
                <field name="warehouse_id" />
                <field name="reason_id" />
                <field name="user_id" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                />
            </list>
        </field>
    </record>

    <record id="nme_stock_adjustment_view_form" model="ir.ui.view">
        <field name="name">nme.stock.adjustment.view.form</field>
        <field name="model">nme.stock.adjustment</field>
        <field name="arch" type="xml">
            <form string="Stock Adjustment">
                <header>
                    <button
                        name="action_validate"
                        type="object"
                        string="Validate"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        groups="nme_inventory.nme_group_inventory_manager"
                    />
                    <button
                        name="action_load_products"
                        type="object"
                        string="Load Products in Stock"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_open_cancel_wizard"
                        type="object"
                        string="Cancel"
                        invisible="state != 'draft'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="warehouse_id"
                                readonly="state != 'draft' or line_ids"
                                options="{'no_create': True}"
                            />
                            <field name="location_id" />
                            <field
                                name="reason_id"
                                readonly="state != 'draft'"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'" />
                            <field name="user_id" readonly="state != 'draft'" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Counted Quantities" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field
                                        name="product_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="theoretical_qty" />
                                    <field name="counted_qty" />
                                    <field
                                        name="difference_qty"
                                        decoration-danger="difference_qty &lt; 0"
                                        decoration-success="difference_qty &gt; 0"
                                    />
                                    <field name="uom_id" />
                                    <field name="currency_id" column_invisible="True" />
                                    <field
                                        name="unit_cost"
                                        widget="monetary"
                                        optional="show"
                                    />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Stock Moves"
                            name="moves"
                            invisible="state != 'done'"
                        >
                            <field name="move_ids" readonly="1" />
                        </page>
                        <page
                            string="Cancellation"
                            name="cancellation"
                            invisible="not cancel_reason"
                        >
                            <field name="cancel_reason" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="nme_stock_adjustment_action" model="ir.actions.act_window">
        <field name="name">Stock Adjustments</field>
        <field name="res_model">nme.stock.adjustment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a stock count</p>
            <p
            >Counted quantities are compared with the system and validated by a manager.</p>
        </field>
    </record>
</odoo>
