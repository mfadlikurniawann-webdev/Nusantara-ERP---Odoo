<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Virtual locations shared by every company: counterparts of the
         stock moves entering or leaving the warehouses. -->
    <record id="nme_location_vendors" model="nme.location">
        <field name="name">Vendors</field>
        <field name="usage">supplier</field>
    </record>
    <record id="nme_location_customers" model="nme.location">
        <field name="name">Customers</field>
        <field name="usage">customer</field>
    </record>
    <record id="nme_location_inventory_loss" model="nme.location">
        <field name="name">Inventory Adjustment</field>
        <field name="usage">inventory</field>
    </record>
</odoo>
