<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Delivery slip (Surat Jalan) for deliveries, receipt slip for receipts. -->
    <template id="report_nme_picking_document">
        <t t-call="web.external_layout">
            <t t-set="address">
                <div
                    t-if="doc.partner_id"
                    t-field="doc.partner_id"
                    t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True}"
                />
            </t>
            <div class="page o_nme_picking_report">
                <h2>
                    <span t-if="doc.picking_type == 'outgoing'">Delivery Slip</span>
                    <span t-elif="doc.picking_type == 'incoming'">Receipt Slip</span>
                    <span t-else="">Internal Transfer</span>
                    <span t-field="doc.name" />
                </h2>
                <div class="row mt-3 mb-3">
                    <div class="col-3" t-if="doc.origin">
                        <strong>Source Document</strong>
                        <div t-field="doc.origin" />
                    </div>
                    <div class="col-3">
                        <strong>Scheduled Date</strong>
                        <div
                            t-field="doc.scheduled_date"
                            t-options="{'widget': 'date'}"
                        />
                    </div>
                    <div class="col-3">
                        <strong>From</strong>
                        <div t-field="doc.location_id" />
                    </div>
                    <div class="col-3">
                        <strong>To</strong>
                        <div t-field="doc.location_dest_id" />
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th class="text-start">Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-start">Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.move_ids" t-as="move">
                            <td>
                                <span t-field="move.product_id" />
                            </td>
                            <td class="text-end">
                                <span t-field="move.quantity" />
                            </td>
                            <td>
                                <span t-field="move.uom_id.code" />
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div t-if="doc.note" class="mt-3" t-field="doc.note" />
                <div class="row mt-5 text-center">
                    <div class="col-4">
                        <div>Prepared by</div>
                        <div class="mt-5 border-top">
                            <span t-field="doc.user_id" />
                        </div>
                    </div>
                    <div class="col-4">
                        <div>Driver</div>
                        <div class="mt-5 border-top">&#160;</div>
                    </div>
                    <div class="col-4">
                        <div>Received by</div>
                        <div class="mt-5 border-top">&#160;</div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_nme_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t
                    t-call="nme_inventory.report_nme_picking_document"
                    t-lang="doc.partner_id.lang or doc.env.lang"
                />
            </t>
        </t>
    </template>
</odoo>
