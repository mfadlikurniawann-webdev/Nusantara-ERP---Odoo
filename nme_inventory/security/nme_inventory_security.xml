<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_privilege_inventory" model="res.groups.privilege">
        <field name="name">Inventory</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_nusantara_erp" />
    </record>

    <record id="nme_group_inventory_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="nme_privilege_inventory" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="comment"
        >Prepares and validates receipts, deliveries and transfers, records stock counts.</field>
    </record>

    <record id="nme_group_inventory_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="nme_privilege_inventory" />
        <field
            name="implied_ids"
            eval="[(4, ref('nme_group_inventory_user')), (4, ref('nme_base.nme_group_master_data_manager'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field
            name="comment"
        >Also validates stock adjustments and manages warehouses and locations.</field>
    </record>
</odoo>
