<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_purchase_report_view_search" model="ir.ui.view">
        <field name="name">nme.purchase.report.view.search</field>
        <field name="model">nme.purchase.report</field>
        <field name="arch" type="xml">
            <search string="Purchase Analysis">
                <field name="product_id" />
                <field name="categ_id" operator="child_of" />
                <field name="partner_id" operator="child_of" />
                <filter name="filter_date" string="Order Date" date="date" />
                <group>
                    <filter
                        name="group_by_partner"
                        string="Vendor"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_by_product"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        name="group_by_month"
                        string="Month"
                        context="{'group_by': 'date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="nme_purchase_report_view_pivot" model="ir.ui.view">
        <field name="name">nme.purchase.report.view.pivot</field>
        <field name="model">nme.purchase.report</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Analysis" sample="1">
                <field name="partner_id" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="amount_untaxed" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="nme_purchase_report_view_graph" model="ir.ui.view">
        <field name="name">nme.purchase.report.view.graph</field>
        <field name="model">nme.purchase.report</field>
        <field name="arch" type="xml">
            <graph string="Purchase Analysis" type="bar" sample="1">
                <field name="partner_id" />
                <field name="amount_untaxed" type="measure" />
            </graph>
        </field>
    </record>

    <record id="nme_purchase_report_view_list" model="ir.ui.view">
        <field name="name">nme.purchase.report.view.list</field>
        <field name="model">nme.purchase.report</field>
        <field name="arch" type="xml">
            <list string="Purchase Analysis" create="false">
                <field name="currency_id" column_invisible="True" />
                <field name="date" widget="date" />
                <field name="order_id" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="qty_ordered" sum="Total" />
                <field name="qty_received" sum="Total" />
                <field name="price_average" widget="monetary" />
                <field name="amount_untaxed" sum="Total" widget="monetary" />
            </list>
        </field>
    </record>

    <record id="nme_purchase_report_action" model="ir.actions.act_window">
        <field name="name">Purchase Analysis</field>
        <field name="res_model">nme.purchase.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No confirmed purchase yet</p>
        </field>
    </record>
</odoo>
