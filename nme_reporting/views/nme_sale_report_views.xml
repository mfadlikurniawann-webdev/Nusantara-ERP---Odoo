<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_sale_report_view_search" model="ir.ui.view">
        <field name="name">nme.sale.report.view.search</field>
        <field name="model">nme.sale.report</field>
        <field name="arch" type="xml">
            <search string="Sales Analysis">
                <field name="product_id" />
                <field name="categ_id" operator="child_of" />
                <field name="partner_id" operator="child_of" />
                <field name="user_id" />
                <filter name="filter_date" string="Order Date" date="date" />
                <group>
                    <filter
                        name="group_by_product"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        name="group_by_categ"
                        string="Product Category"
                        context="{'group_by': 'categ_id'}"
                    />
                    <filter
                        name="group_by_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_by_user"
                        string="Salesperson"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="group_by_month"
                        string="Month"
                        context="{'group_by': 'date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="nme_sale_report_view_pivot" model="ir.ui.view">
        <field name="name">nme.sale.report.view.pivot</field>
        <field name="model">nme.sale.report</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis" sample="1">
                <field name="categ_id" type="row" />
                <field name="date" interval="month" type="col" />
                <field name="amount_untaxed" type="measure" />
                <field name="margin" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="nme_sale_report_view_graph" model="ir.ui.view">
        <field name="name">nme.sale.report.view.graph</field>
        <field name="model">nme.sale.report</field>
        <field name="arch" type="xml">
            <graph string="Sales Analysis" type="line" sample="1">
                <field name="date" interval="month" />
                <field name="amount_untaxed" type="measure" />
            </graph>
        </field>
    </record>

    <record id="nme_sale_report_view_list" model="ir.ui.view">
        <field name="name">nme.sale.report.view.list</field>
        <field name="model">nme.sale.report</field>
        <field name="arch" type="xml">
            <list string="Sales Analysis" create="false">
                <field name="currency_id" column_invisible="True" />
                <field name="date" widget="date" />
                <field name="order_id" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="qty_ordered" sum="Total" />
                <field name="qty_delivered" sum="Total" />
                <field name="amount_untaxed" sum="Total" widget="monetary" />
                <field name="cost" sum="Total" widget="monetary" optional="show" />
                <field name="margin" sum="Total" widget="monetary" optional="show" />
            </list>
        </field>
    </record>

    <record id="nme_sale_report_action" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">nme.sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_filter_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No confirmed sales yet</p>
        </field>
    </record>
</odoo>
