msgstr "%(order)s bernilai %(amount)s dan memerlukan persetujuan Anda."

#. module: nme_purchase
#: model:ir.actions.report,print_report_name:nme_purchase.action_report_nme_purchase_order
msgid ""
"(object.state in ('draft', 'sent') and 'RFQ - %s' or 'PO - %s') % "
"object.name.replace('/', '-')"
msgstr ""
"(object.state in ('draft', 'sent') and 'RFQ - %s' or 'PO - %s') % "
"object.name.replace('/', '-')"

#. module: nme_purchase
#: model:mail.template,body_html:nme_purchase.mail_template_nme_purchase_order
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear <t t-out=\"object.partner_id.name or ''\">PT Beras Nusantara</t>,\n"
"                    <br/><br/>\n"
"                    <t t-if=\"object.state in ('draft', 'sent')\">\n"
"                        Please find attached our request for quotation\n"
"                    </t>\n"
"                    <t t-else=\"\">Please find attached our purchase order</t>\n"
"                    <strong t-out=\"object.name or ''\">PO/2026/00001</strong>.\n"
"                    <t t-if=\"object.date_planned\">\n"
"                        <br/>We expect the delivery on\n"
"                        <t t-out=\"format_date(object.date_planned) or ''\">01/31/2026</t>.\n"
"                    </t>\n"
"                    <br/><br/>\n"
"                    Thank you,\n"
"                    <br/>\n"
"                    <t t-out=\"object.user_id.name or object.company_id.name or ''\">Purchasing</t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Yth. <t t-out=\"object.partner_id.name or ''\">PT Beras Nusantara</t>,\n"
"                    <br/><br/>\n"
"                    <t t-if=\"object.state in ('draft', 'sent')\">\n"
"                        Terlampir kami sampaikan permintaan penawaran harga (RFQ)\n"
"                    </t>\n"
"                    <t t-else=\"\">Terlampir kami sampaikan pesanan pembelian</t>\n"
"                    <strong t-out=\"object.name or ''\">PO/2026/00001</strong>.\n"
"                    <t t-if=\"object.date_planned\">\n"
"                        <br/>Kami mengharapkan pengiriman pada tanggal\n"
"                        <t t-out=\"format_date(object.date_planned) or ''\">01/31/2026</t>.\n"
"                    </t>\n"
"                    <br/><br/>\n"
"                    Terima kasih,\n"
"                    <br/>\n"
"                    <t t-out=\"object.user_id.name or object.company_id.name or ''\">Bagian Pembelian</t>\n"
"                </p>\n"
"            </div>\n"
"        "

