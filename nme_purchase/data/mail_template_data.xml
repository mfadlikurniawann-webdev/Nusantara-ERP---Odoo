<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="mail_template_nme_purchase_order" model="mail.template">
        <field name="name">Nusantara ERP: Send Purchase Order</field>
        <field name="model_id" ref="model_nme_purchase_order" />
        <field
            name="subject"
        >{{ object.company_id.name }} {{ object.state in ('draft', 'sent') and 'Request for Quotation' or 'Purchase Order' }} (Ref {{ object.name }})</field>
        <field
            name="email_from"
        >{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to" eval="False" />
        <field name="use_default_to" eval="True" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field
            name="report_template_ids"
            eval="[(4, ref('action_report_nme_purchase_order'))]"
        />
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.partner_id.name or ''">PT Beras Nusantara</t>,
                    <br /><br />
                    <t t-if="object.state in ('draft', 'sent')">
                        Please find attached our request for quotation
                    </t>
                    <t t-else="">Please find attached our purchase order</t>
                    <strong t-out="object.name or ''">PO/2026/00001</strong>.
                    <t t-if="object.date_planned">
                        <br />We expect the delivery on
                        <t
                            t-out="format_date(object.date_planned) or ''"
                        >01/31/2026</t>.
                    </t>
                    <br /><br />
                    Thank you,
                    <br />
                    <t
                        t-out="object.user_id.name or object.company_id.name or ''"
                    >Purchasing</t>
                </p>
            </div>
        </field>
    </record>
</odoo>
