<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_privilege_purchase" model="res.groups.privilege">
        <field name="name">Purchase</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_nusantara_erp" />
    </record>

    <record id="nme_group_purchase_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="nme_privilege_purchase" />
        <field
            name="implied_ids"
            eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"
        />
        <field
            name="comment"
        >Prepares requests for quotation and confirms purchase orders below the approval amount.</field>
    </record>

    <record id="nme_group_purchase_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="nme_privilege_purchase" />
        <field
            name="implied_ids"
            eval="[(4, ref('nme_group_purchase_user')), (4, ref('nme_base.nme_group_master_data_manager'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field
            name="comment"
        >Approves or rejects purchase orders above the approval amount.</field>
    </record>
</odoo>
