<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_sale_order_view_search" model="ir.ui.view">
        <field name="name">nme.sale.order.view.search</field>
        <field name="model">nme.sale.order</field>
        <field name="arch" type="xml">
            <search string="Sales Orders">
                <field
                    name="name"
                    string="Order"
                    filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'child_of', self)]"
                />
                <field name="partner_id" operator="child_of" />
                <field name="user_id" />
                <field
                    name="line_ids"
                    string="Product"
                    filter_domain="[('line_ids.product_id', 'ilike', self)]"
                />
                <filter
                    name="filter_my_orders"
                    string="My Orders"
                    domain="[('user_id', '=', uid)]"
                />
                <separator />
                <filter
                    name="filter_quotations"
                    string="Quotations"
                    domain="[('state', 'in', ('draft', 'sent'))]"
                />
                <filter
                    name="filter_orders"
                    string="Sales Orders"
                    domain="[('state', '=', 'sale')]"
                />
                <filter
                    name="filter_to_deliver"
                    string="To Deliver"
                    domain="[('delivery_status', 'in', ('to_deliver', 'partial'))]"
                />
                <separator />
                <filter
                    name="filter_date_order"
                    string="Order Date"
                    date="date_order"
                />
                <group>
                    <filter
                        name="group_by_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_by_user"
                        string="Salesperson"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_date_order"
                        string="Order Date"
                        context="{'group_by': 'date_order:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="nme_sale_order_view_list" model="ir.ui.view">
        <field name="name">nme.sale.order.view.list</field>
        <field name="model">nme.sale.order</field>
        <field name="arch" type="xml">
            <list
                string="Sales Orders"
                sample="1"
                decoration-muted="state == 'cancel'"
                decoration-info="state in ('draft', 'sent')"
            >
                <field name="currency_id" column_invisible="True" />
                <field name="name" decoration-bf="1" />
                <field name="date_order" widget="date" />
                <field name="partner_id" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="commitment_date" optional="hide" />
                <field
                    name="amount_untaxed"
                    sum="Total Untaxed"
                    widget="monetary"
                    optional="hide"
                />
                <field
                    name="amount_total"
                    sum="Total"
                    widget="monetary"
                    decoration-bf="1"
                />
                <field
                    name="delivery_status"
                    widget="badge"
                    optional="show"
                    decoration-success="delivery_status == 'delivered'"
                    decoration-warning="delivery_status in ('to_deliver', 'partial')"
                    invisible="state != 'sale'"
                />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'sale'"
                    decoration-info="state in ('draft', 'sent')"
                />
            </list>
        </field>
    </record>

    <record id="nme_sale_order_view_kanban" model="ir.ui.view">
        <field name="name">nme.sale.order.view.kanban</field>
        <field name="model">nme.sale.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="currency_id" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="partner_id" class="fw-bold fs-5" />
                            <field
                                name="amount_total"
                                widget="monetary"
                                class="ms-auto fw-bold"
                            />
                        </div>
                        <field name="name" class="text-muted" />
                        <footer>
                            <field name="date_order" widget="date" />
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                class="ms-auto"
                            />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="nme_sale_order_view_calendar" model="ir.ui.view">
        <field name="name">nme.sale.order.view.calendar</field>
        <field name="model">nme.sale.order</field>
        <field name="arch" type="xml">
            <calendar
                string="Deliveries Promised"
                date_start="commitment_date"
                color="user_id"
                mode="month"
                event_limit="5"
                quick_create="0"
            >
                <field name="partner_id" />
                <field name="amount_total" />
                <field name="delivery_status" />
            </calendar>
        </field>
    </record>

    <record id="nme_sale_order_view_pivot" model="ir.ui.view">
        <field name="name">nme.sale.order.view.pivot</field>
        <field name="model">nme.sale.order</field>
        <field name="arch" type="xml">
            <pivot string="Sales Orders" sample="1">
                <field name="date_order" interval="month" type="row" />
                <field name="amount_total" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="nme_sale_order_view_graph" model="ir.ui.view">
        <field name="name">nme.sale.order.view.graph</field>
        <field name="model">nme.sale.order</field>
        <field name="arch" type="xml">
            <graph string="Sales Orders" sample="1">
                <field name="partner_id" />
                <field name="amount_total" type="measure" />
            </graph>
        </field>
    </record>

    <record id="nme_sale_order_view_form" model="ir.ui.view">
        <field name="name">nme.sale.order.view.form</field>
        <field name="model">nme.sale.order</field>
        <field name="arch" type="xml">
            <form string="Sales Order">
                <header>
                    <button
                        name="action_quotation_send"
                        type="object"
                        string="Send by Email"
                        class="btn-primary"
                        invisible="state != 'draft'"
                        data-hotkey="g"
                    />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        invisible="state != 'sent'"
                        data-hotkey="v"
                    />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        invisible="state != 'draft'"
                        data-hotkey="v"
                    />
                    <button
                        name="action_quotation_send"
                        type="object"
                        string="Send by Email"
                        invisible="state not in ('sent', 'sale')"
                    />
                    <button
                        name="nme_sales.action_report_nme_sale_order"
                        type="action"
                        string="Print"
                        invisible="state == 'cancel'"
                    />
                    <button
                        name="action_open_cancel_wizard"
                        type="object"
                        string="Cancel"
                        invisible="state == 'cancel'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Set to Quotation"
                        invisible="state != 'cancel'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,sent,sale"
                    />
                </header>
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not credit_warning"
                >
                    <field name="credit_warning" />
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_deliveries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            invisible="not delivery_count"
                        >
                            <field
                                name="delivery_count"
                                widget="statinfo"
                                string="Delivery"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group name="partner">
                            <field
                                name="partner_id"
                                readonly="state in ('sale', 'cancel')"
                                context="{'default_nme_is_customer': True}"
                            />
                            <field
                                name="payment_term_id"
                                readonly="state in ('sale', 'cancel')"
                                options="{'no_create': True}"
                            />
                            <field
                                name="warehouse_id"
                                readonly="state in ('sale', 'cancel')"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group name="dates">
                            <field
                                name="date_order"
                                readonly="state in ('sale', 'cancel')"
                            />
                            <field
                                name="validity_date"
                                invisible="state in ('sale', 'cancel')"
                            />
                            <field
                                name="commitment_date"
                                readonly="state in ('sale', 'cancel')"
                            />
                            <field name="delivery_status" invisible="state != 'sale'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="lines">
                            <field
                                name="line_ids"
                                readonly="state in ('sale', 'cancel')"
                            >
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="product_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="name" optional="show" />
                                    <field name="quantity" />
                                    <field name="uom_id" optional="show" />
                                    <field
                                        name="qty_delivered"
                                        optional="show"
                                        column_invisible="parent.state != 'sale'"
                                    />
                                    <field name="price_unit" />
                                    <field name="discount" optional="show" />
                                    <field
                                        name="tax_ids"
                                        widget="many2many_tags"
                                        options="{'no_create': True}"
                                        domain="[('type_tax_use', '=', 'sale'), ('company_id', '=', parent.company_id)]"
                                    />
                                    <field name="currency_id" column_invisible="True" />
                                    <field name="price_subtotal" widget="monetary" />
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" name="totals">
                                <field name="currency_id" invisible="1" />
                                <field name="amount_untaxed" widget="monetary" />
                                <field name="amount_tax" widget="monetary" />
                                <field
                                    name="amount_total"
                                    widget="monetary"
                                    class="oe_subtotal_footer_separator"
                                />
                            </group>
                            <field name="note" placeholder="Terms and conditions..." />
                        </page>
                        <page string="Other Information" name="other_info">
                            <group>
                                <group name="sales">
                                    <field name="user_id" />
                                    <field
                                        name="company_id"
                                        groups="base.group_multi_company"
                                        readonly="state != 'draft'"
                                    />
                                </group>
                                <group
                                    name="cancellation"
                                    invisible="not cancel_reason"
                                >
                                    <field name="cancel_reason" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="nme_sale_order_action_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">nme.sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field
            name="context"
        >{'search_default_filter_my_orders': 1, 'search_default_filter_quotations': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new quotation</p>
            <p
            >Once confirmed, a quotation becomes a sales order and its goods are delivered.</p>
        </field>
    </record>

    <record id="nme_sale_order_action_orders" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">nme.sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
        <field name="domain">[('state', 'not in', ('draft', 'sent', 'cancel'))]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="nme_sale_order_action_confirm" model="ir.actions.server">
        <field name="name">Confirm Quotations</field>
        <field name="model_id" ref="model_nme_sale_order" />
        <field name="binding_model_id" ref="model_nme_sale_order" />
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('nme_group_sales_user'))]" />
        <field name="state">code</field>
        <field
            name="code"
        >records.filtered(lambda o: o.state in ('draft', 'sent')).action_confirm()</field>
    </record>
</odoo>
