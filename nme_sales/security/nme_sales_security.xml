<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nme_privilege_sales" model="res.groups.privilege">
        <field name="name">Sales</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_nusantara_erp" />
    </record>

    <record id="nme_group_sales_user" model="res.groups">
        <field name="name">User: Own Documents Only</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="nme_privilege_sales" />
        <field
            name="implied_ids"
            eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"
        />
        <field name="comment">Manages their own quotations and sales orders.</field>
    </record>

    <record id="nme_group_sales_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="nme_privilege_sales" />
        <field
            name="implied_ids"
            eval="[(4, ref('nme_group_sales_user')), (4, ref('nme_base.nme_group_master_data_manager'))]"
        />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field
            name="comment"
        >Sees every sales order, sets credit limits and may confirm orders above them.</field>
    </record>
</odoo>
