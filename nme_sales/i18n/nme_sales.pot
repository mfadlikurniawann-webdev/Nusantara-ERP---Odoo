#. module: nme_sales
#: model:mail.template,body_html:nme_sales.mail_template_nme_sale_order
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Hello <t t-out=\"object.partner_id.name or ''\">Toko Makmur Jaya</t>,\n"
"                    <br/><br/>\n"
"                    Please find attached\n"
"                    <t t-if=\"object.state in ('draft', 'sent')\">the quotation</t>\n"
"                    <t t-else=\"\">the order confirmation</t>\n"
"                    <strong t-out=\"object.name or ''\">SO/2026/00001</strong>\n"
"                    amounting to\n"
"                    <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">Rp 1.000.000</strong>.\n"
"                    <t t-if=\"object.validity_date and object.state in ('draft', 'sent')\">\n"
"                        <br/>This quotation is valid until\n"
"                        <t t-out=\"format_date(object.validity_date) or ''\">01/31/2026</t>.\n"
"                    </t>\n"
"                    <br/><br/>\n"
"                    Do not hesitate to contact us if you have any questions.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

